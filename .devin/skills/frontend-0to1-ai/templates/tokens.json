{
  "$schema": "https://www.w3.org/community/reports/design-tokens/CG-FINAL-format-20251028/",
  "$description": "阶段 2 产物。W3C Design Tokens 格式；所有页面/组件只引用此处 token，禁止硬编码。暗色用 $extensions.modes.dark 覆盖。",
  "color": {
    "brand": {
      "500": { "$type": "color", "$value": "#2563eb", "$description": "主色；按钮/链接/焦点环" },
      "600": { "$type": "color", "$value": "#1d4ed8" }
    },
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "50": { "$type": "color", "$value": "#f8fafc" },
      "200": { "$type": "color", "$value": "#e2e8f0" },
      "500": { "$type": "color", "$value": "#64748b" },
      "700": { "$type": "color", "$value": "#334155" },
      "900": { "$type": "color", "$value": "#0f172a" },
      "950": { "$type": "color", "$value": "#020617" }
    },
    "semantic": {
      "success": { "$type": "color", "$value": "#16a34a" },
      "warning": { "$type": "color", "$value": "#d97706" },
      "danger": { "$type": "color", "$value": "#dc2626" },
      "info": { "$type": "color", "$value": "{color.brand.500}" }
    },
    "role": {
      "bg": { "$type": "color", "$value": "{color.neutral.0}", "$extensions": { "modes": { "dark": "{color.neutral.950}" } } },
      "surface": { "$type": "color", "$value": "{color.neutral.50}", "$extensions": { "modes": { "dark": "{color.neutral.900}" } } },
      "border": { "$type": "color", "$value": "{color.neutral.200}", "$extensions": { "modes": { "dark": "{color.neutral.700}" } } },
      "fg": { "$type": "color", "$value": "{color.neutral.900}", "$extensions": { "modes": { "dark": "{color.neutral.50}" } } },
      "fg-muted": { "$type": "color", "$value": "{color.neutral.500}", "$extensions": { "modes": { "dark": "{color.neutral.200}" } } },
      "primary": { "$type": "color", "$value": "{color.brand.500}" },
      "on-primary": { "$type": "color", "$value": "{color.neutral.0}" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "Noto Sans SC", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "sm": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
      "md": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "lg": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
      "xl": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
      "2xl": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.2 },
      "body": { "$type": "number", "$value": 1.5 }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    }
  },
  "space": {
    "$description": "8pt 网格；4 仅用于图标与文字间距",
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "16": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "full": { "$type": "dimension", "$value": { "value": 9999, "unit": "px" } }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": { "color": "#0f172a14", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "md": { "$type": "shadow", "$value": { "color": "#0f172a1f", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 12, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } }
  },
  "size": {
    "hit": { "$type": "dimension", "$value": { "value": 40, "unit": "px" }, "$description": "最小点击热区" },
    "control": { "$type": "dimension", "$value": { "value": 40, "unit": "px" }, "$description": "默认控件高度" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } },
    "base": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  }
}
