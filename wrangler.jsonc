{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ui-gallery",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "./dist", "not_found_handling": "none", "html_handling": "auto-trailing-slash" },
  "routes": [{ "pattern": "ui.zalize.com", "custom_domain": true }],
  "workers_dev": true
}
